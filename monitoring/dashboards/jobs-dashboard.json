{
  "uid": "orders-jobs",
  "title": "Orders - Job & CronJob Monitoring",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Succeeded Jobs",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "sum(kube_job_complete{namespace=\"orders\",condition=\"true\"}) or vector(0)", "instant": true } ],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "green" } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none" }
    },
    {
      "id": 2, "type": "stat", "title": "Failed Jobs",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "sum(kube_job_failed{namespace=\"orders\",condition=\"true\"}) or vector(0)", "instant": true } ],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none" }
    },
    {
      "id": 3, "type": "stat", "title": "Running Jobs",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "sum(kube_job_status_active{namespace=\"orders\"}) or vector(0)", "instant": true } ],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none" }
    },
    {
      "id": 4, "type": "stat", "title": "Success Rate",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "100 * (sum(kube_job_complete{namespace=\"orders\",condition=\"true\"}) or vector(0)) / clamp_min((sum(kube_job_complete{namespace=\"orders\",condition=\"true\"}) or vector(0)) + (sum(kube_job_failed{namespace=\"orders\",condition=\"true\"}) or vector(0)), 1)", "instant": true } ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "orange", "value": 60 }, { "color": "green", "value": 90 } ] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none" }
    },
    {
      "id": 5, "type": "timeseries", "title": "Succeeded vs Failed Jobs over time",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "legendFormat": "succeeded", "expr": "sum(kube_job_complete{namespace=\"orders\",condition=\"true\"}) or vector(0)" },
        { "refId": "B", "legendFormat": "failed", "expr": "sum(kube_job_failed{namespace=\"orders\",condition=\"true\"}) or vector(0)" }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "succeeded" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] },
          { "matcher": { "id": "byName", "options": "failed" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] }
        ]
      }
    },
    {
      "id": 6, "type": "table", "title": "Job status (1 = true)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "format": "table", "instant": true, "expr": "kube_job_complete{namespace=\"orders\",condition=\"true\"}" },
        { "refId": "B", "format": "table", "instant": true, "expr": "kube_job_failed{namespace=\"orders\",condition=\"true\"}" }
      ],
      "transformations": [
        { "id": "labelsToFields", "options": {} },
        { "id": "organize", "options": { "includeByName": { "job_name": true, "Value": true }, "renameByName": { "job_name": "Job" } } }
      ]
    },
    {
      "id": 7, "type": "stat", "title": "CronJob last schedule",
      "gridPos": { "h": 5, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "legendFormat": "{{cronjob}}", "expr": "kube_cronjob_status_last_schedule_time{namespace=\"orders\"} * 1000", "instant": true } ],
      "fieldConfig": { "defaults": { "unit": "dateTimeAsLocal" }, "overrides": [] },
      "options": { "graphMode": "none" }
    },
    {
      "id": 8, "type": "stat", "title": "CronJob next schedule",
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "legendFormat": "{{cronjob}}", "expr": "kube_cronjob_next_schedule_time{namespace=\"orders\"} * 1000", "instant": true } ],
      "fieldConfig": { "defaults": { "unit": "dateTimeAsLocal" }, "overrides": [] },
      "options": { "graphMode": "none" }
    }
  ]
}
